@startuml
!theme plain
left to right direction
hide class circle
hide class methods
skinparam classAttributeIconSize 0
' skinparam linetype polyline
skinparam linetype ortho

mainframe SMT PredictiveMaintenance

class "PredictiveMaintenance" as ID00000001 <<SM>> {
  +RemainingUsefulLifePrediction : SMC
}

class "RemainingUsefulLifePrediction" as ID00000002 <<SMC>> {
  +RemainingUsefulLifetime : Ent
  +RemainingUsfulLifeDateTime : xs:dateTime [0..1] = "2028-09-13T0..."
  +ConfidenceInterval : Range = "10800 .. 13200"
  +ListRULBoundaryConditions : SML
  +PredictionModelInformation : SMC
  +ListPreAlerts : SML [0..1]
  +AlertAfterExceedingRemainingUsableLife : SMC [0..1]
}

class "RemainingUsefulLifetime" as ID00000003 <<Ent>> {
  +IndicationType : xs:string = "operating hours"
  +DurationValue : xs:double = "12000"
  +EngineeringUnit : xs:string = "h"
  +StartValue : xs:double = "8420"
  +StartDateTime : xs:dateTime [0..1] = "2026-09-13T0..."
  +Description : xs:string [0..1] = "Illustrative..."
}

class "ListRULBoundaryConditions" as ID00000004 <<SML>> {
  +[00]  : SMC [1..*]
  +[01]  : SMC [1..*]
  +[02]  : SMC [1..*]
  +[03]  : SMC [1..*]
}

class "PredictionModelInformation" as ID00000005 <<SMC>> {
  +ModelType : xs:string = "ModelTypeHybrid"
  +ModelDescription : xs:string [0..1] = "Illustrative..."
  +SMAIModelNamePlate : Ref [0..1]
}

class "ListPreAlerts" as ID00000006 <<SML>> {
  +[00]  : SMC [0..*]
}

class "AlertAfterExceedingRemainingUsableLife" as ID00000007 <<SMC>> {
  +AlertMessage : xs:string [0..1] = "No active al..."
  +MaintenanceRequired : xs:boolean = "false"
}

ID00000002 *--  ID00000003 : ""
ID00000002 *--  ID00000004 : ""
