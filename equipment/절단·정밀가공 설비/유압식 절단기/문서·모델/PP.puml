@startuml
!theme plain
left to right direction
hide class circle
hide class methods
skinparam classAttributeIconSize 0
' skinparam linetype polyline
skinparam linetype ortho

mainframe SMT ProcessParameters

class "ProcessParameters" as ID00000001 <<SM>> {
  +Processes : SMC
}

class "Processes" as ID00000002 <<SMC>> {
  +Process__00__ : SMC [0..*]
}

class "Process__00__" as ID00000003 <<SMC>> {
  +ProcessId : xs:string = "HC-P-001"
  +ProcessName : xs:string = "Plate sheari..."
  +ProcessDescription : MLP = "Process para..."
  +PlannedProcessTime : xs:duration = "PT2H"
  +ProductParameters : SMC
  +ProcessParameters : SMC
  +ResourceParameters : SMC
  +ProcessBoM : SMC
}

class "ProductParameters" as ID00000004 <<SMC>> {
  +WorkpieceRequirements : SMC
